# Server only. Never use a NEXT_PUBLIC_ prefix for secrets.
NOTION_TOKEN=your_notion_integration_token
# Background check cadence (seconds; minimum 30). Browser refreshes every 15 seconds.
NOTION_SYNC_INTERVAL_SECONDS=60
# Watchdog limit for one sync; stalled progress is also detected after 180 seconds.
NOTION_SYNC_TIMEOUT_SECONDS=600
# Shreehan Digital Twin (server only)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-120b

# SQLite and local runtime state (Docker sets these to its persistent volume)
DATABASE_PATH=data/shreehan.db
NOTION_SYNC_DIR=.notion-sync
APP_ENV=development

# Set a real SMTP account for signup/recovery emails. Without SMTP, development OTPs appear only in the server log.
# Use port 587 for STARTTLS or port 465 for implicit TLS. SMTP_FROM must be accepted by your provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Shreehan HQ <noreply@example.com>
