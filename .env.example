# Server only. Never use a NEXT_PUBLIC_ prefix for secrets.
CONTENT_SOURCE=notion
# The Notion importer also reads the linked half-yearly Drive folder when Drive credentials are configured.
GOOGLE_DRIVE_FOLDER_ID=1pg3lbrlzwxJClmKCMQEpZg-9aMIrHnwr
# Optional Google API key: can enumerate/download only files the API can access publicly.
# Private Drive folders require the service account JSON or all three OAuth values below.
G_DRIVE_KEY=
# Share the source folder with this service account, then set its complete JSON key as one server secret.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Alternatively use all three OAuth settings below (read-only Drive scope).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SYNC_INTERVAL_SECONDS=30
GOOGLE_DRIVE_SYNC_TIMEOUT_SECONDS=1200

NOTION_TOKEN=your_notion_integration_token
# Background check cadence (seconds; minimum 30). Browser refreshes every 15 seconds.
NOTION_SYNC_INTERVAL_SECONDS=30
# Watchdog limit for one sync; large scanned PDFs may need several minutes of OCR.
NOTION_SYNC_TIMEOUT_SECONDS=1200
# Shreehan Digital Twin (server only)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-120b

# SQLite and local runtime state (Docker sets these to its persistent volume)
DATABASE_PATH=data/shreehan.db
NOTION_SYNC_DIR=.notion-sync
APP_ENV=development

# Set a real SMTP account for signup/recovery emails. Without SMTP, development OTPs appear only in the server log.
# Use port 587 for STARTTLS or port 465 for implicit TLS. SMTP_FROM must be accepted by your provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Shreehan HQ <noreply@example.com>

# Recommended email delivery on Vercel: Resend free tier (100/day, 3,000/month).
# Use a verified domain sender; resend.dev only supports restricted testing.
# Both values are required together. Resend takes precedence over SMTP.
RESEND_API_KEY=
RESEND_FROM=
